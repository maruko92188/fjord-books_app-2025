<div class="comment-item">
  <p>
    <strong><%= t('views.common.poster') %>:</strong>
    <%= comment.user.present? ? current_user_name(comment.user) : t('views.common.have_been_deleted', name: User.model_name.human) %>
  </p>

  <p>
    <strong><%= t('views.common.post_date') %>:</strong>
    <%= l(comment.created_at, format: :short) %>
  </p>

  <p>
    <strong><%= Comment.human_attribute_name(:body) %>:</strong>
    <%= comment.body %>
  </p>

<% if comment.user == current_user %>
  <nav class="page-nav">
    <%= link_to t('views.common.edit', name: Comment.model_name.human.downcase), [:edit, comment.commentable, comment] %>
    <%= button_to t('views.common.destroy', name: Comment.model_name.human.downcase), [comment.commentable, comment], method: :delete %>
  </nav>
<% end %>

</div>
